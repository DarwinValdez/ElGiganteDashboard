# =====================================================================
# EL GIGANTE SUPERMARKET — variables de entorno
# Copie este archivo a .env.local (desarrollo) y configure las mismas
# variables en Vercel → Project → Settings → Environment Variables.
# =====================================================================

# --- Supabase (públicas: se envían al navegador; protegidas por RLS) ---
# Supabase → Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave publicable (sb_publishable_...) o la clave "anon" legada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SECRETA: sólo servidor) ---
# Necesaria únicamente para crear usuarios / cambiar contraseñas desde /users.
# Nunca use el prefijo NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# --- OCR / visión artificial (SECRETA: sólo servidor) ---
# Proveedor: Anthropic Claude (lee imágenes JPG/PNG/WEBP y PDF).
# Obtenga la clave en https://console.anthropic.com → API Keys.
# Sin esta clave el sistema NO simula el OCR: las facturas quedan en
# "OCR fallido" y se capturan manualmente.
OCR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional: modelo de visión (por defecto claude-opus-5-5)
OCR_MODEL=claude-opus-5-5
